#!/bin/sh /etc/rc.common
# zray: REALITY/VLESS client. SOCKS5 on 127.0.0.1:10800, transparent
# REDIRECT inbound on :1080 (fed by the nft "inet gfw" table).

START=99
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /mnt/zray/zray /mnt/zray/config.json
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}